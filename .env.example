# Copy this file to .env and fill in real values. Never commit .env.

# Supabase (regions, cached hazard metrics, adaptation strategy library)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Anthropic (Claude Opus 5 / Sonnet 5 — powers the 5-agent AI Briefing system
# and the Intelligence Brief PDF generator)
ANTHROPIC_API_KEY=

# NASA FIRMS (optional — live wildfire satellite detections; falls back to a
# clearly-labeled modeled fire-weather estimate when unset)
FIRMS_API_KEY=

# Legacy: still powers /api/tts (text-to-speech) — Anthropic has no TTS
# endpoint, so this hasn't been migrated off Lovable's AI Gateway yet.
LOVABLE_API_KEY=
